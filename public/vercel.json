{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cv-n-backend.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://cv-n-backend.vercel.app/uploads/:path*"
    },
    {
      "source": "/p/:slug",
      "destination": "https://cv-n-backend.vercel.app/p/:slug"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/payment-result",
      "destination": "/payment-result.html"
    },
    {
      "source": "/receipt",
      "destination": "/receipt.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/track-order",
      "destination": "/track-order.html"
    },
    {
      "source": "/unsubscribe",
      "destination": "/unsubscribe.html"
    },
    {
      "source": "/about",
      "destination": "/content.html"
    },
    {
      "source": "/faq",
      "destination": "/content.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/content.html"
    },
    {
      "source": "/terms",
      "destination": "/content.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/content.html"
    },
    {
      "source": "/returns-policy",
      "destination": "/content.html"
    },
    {
      "source": "/category/:slug",
      "destination": "/shop.html"
    },
    {
      "source": "/brand/:slug",
      "destination": "/shop.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    }
  ]
}
